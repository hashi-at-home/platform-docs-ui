{
  "name": "@hashiatho.me/docs-ui",
  "private": true,
  "description": "User Interface module for Platform Documentation",
  "homepage": "https://github.com/hashi-at-home/platform-docs-ui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hashi-at-home/platform-docs-ui.git"
  },
  "type": "module",
  "engines": {
    "node": ">= 24.0.0 <25"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "devDependencies": {
    "@asciidoctor/core": ">=3.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/monaspace-argon": ">=5.0",
    "@fontsource/monaspace-krypton": ">=5.0",
    "@fontsource/monaspace-radon": ">=5.0",
    "@vscode/gulp-vinyl-zip": ">=2.6",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.0",
    "browser-pack-flat": "^3.5.0",
    "browserify": "^17.0.1",
    "cssnano": "^8.0.1",
    "devicons": "^2.0.1",
    "eslint": "^10.4.1",
    "fancy-log": "^2.0.0",
    "fs-extra": "^11.2.0",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-connect": "^5.0.0",
    "gulp-eslint": "^6.0.0",
    "gulp-imagemin": "^9.0.0",
    "gulp-postcss": "^10.0.0",
    "gulp-stylelint": "^13.0.0",
    "gulp-uglify": "^3.0.2",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "merge-stream": "^2.0.0",
    "npm-check-updates": "^22.0.0",
    "plugin-error": "^2.0.1",
    "postcss": "^8.4.0",
    "postcss-calc": "^10.1.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-import": "^16.1.1",
    "postcss-url": "^10.1.4",
    "prettier-eslint": "^16.3.0",
    "require-directory": "^2.1.1",
    "require-from-string": "^2.0.2",
    "stylelint": "^13.13.1",
    "stylelint-config-standard": "^20.0.0",
    "undertaker": "^2.0.0",
    "vinyl-fs": "^4.0.2"
  },
  "release": {
    "branches": [
      "main"
    ],
    "repositoryUrl": "https://github.com/hashi-at-home/platform-docs-ui",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/exec",
        {
          "publishCmd": "gulp"
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md"
          ]
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "build/ui-bundle.zip",
              "label": "UI Bundle",
              "name": "ui-bundle-${nextRelease.version}.zip"
            }
          ]
        }
      ]
    ]
  },
  "version": "1.1.1",
  "dependencies": {
    "@semantic-release/exec": "^7.1.0"
  }
}
